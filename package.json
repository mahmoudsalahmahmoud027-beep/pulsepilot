{
  "name": "pulsepilot",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "scripts": {
    "dev": "tsx server.ts",
    "build": "vite build --configLoader runner && vite build --configLoader runner --ssr server.ts --outDir dist/server",
    "start": "node -e \"process.env.NODE_ENV='production';import('./dist/server/server.js')\"",
    "preview": "vite preview",
    "clean": "node -e \"for(const p of ['dist','.test-build'])require('fs').rmSync(p,{recursive:true,force:true})\"",
    "lint": "tsc --noEmit",
    "test": "vite build --configLoader runner --ssr src/services/engines.test.ts --outDir .test-build && node --test .test-build/engines.test.js"
  },
  "dependencies": {
    "@google/genai": "^2.4.0",
    "@tailwindcss/vite": "^4.1.14",
    "@vitejs/plugin-react": "^5.0.4",
    "dotenv": "^17.2.3",
    "express": "^4.21.2",
    "lucide-react": "^0.546.0",
    "react": "^19.0.1",
    "react-dom": "^19.0.1",
    "vite": "^6.2.3"
  },
  "devDependencies": {
    "@types/express": "^4.17.21",
    "@types/node": "^22.14.0",
    "autoprefixer": "^10.4.21",
    "esbuild": "^0.25.0",
    "tailwindcss": "^4.1.14",
    "tsx": "^4.21.0",
    "typescript": "~5.8.2",
    "vite": "^6.2.3"
  }
}
